<% content_for :title, @product_category.name %>

<% if notice.present? %>
  <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px; border-radius: 10px;">
    <i class="bi bi-check-circle me-2"></i><%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<nav class="navbar navbar-expand-lg sticky-top shadow-sm">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center fw-bold" do %>
      <i class="bi bi-fire me-2 text-danger"></i>
      <span>ZARBA KITCHEN</span>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-lg-3">
        <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "Categories", product_categories_path, class: "nav-link active fw-bold" %></li>
        <li class="nav-item"><%= link_to "Products", products_path, class: "nav-link" %></li>
      </ul>
    </div>
  </div>
</nav>

<div class="page-header">
  <div class="container">
    <div class="d-flex align-items-center gap-3">
      <%= link_to product_categories_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Kembali
      <% end %>
      <div>
        <h1 class="fw-bold mb-2" style="color: var(--primary-red);">
          <i class="bi bi-tag me-2"></i><%= @product_category.name.upcase %>
        </h1>
        <p class="text-muted mb-0">Detail informasi kategori produk</p>
      </div>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="row">
    <div class="col-lg-8">
      <div class="detail-card">
        <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
          <i class="bi bi-info-circle me-2"></i>Informasi Kategori
        </h3>
        
        <div class="info-item">
          <div class="info-label">Nama Kategori</div>
          <div class="info-value"><%= @product_category.name %></div>
        </div>

        <div class="info-item">
          <div class="info-label">Slug</div>
          <div class="info-value">
            <code style="background: #f0f0f0; padding: 5px 10px; border-radius: 5px; font-size: 0.9rem;">
              <%= @product_category.slug %>
            </code>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Jumlah Produk</div>
          <div class="info-value">
            <span class="badge bg-primary" style="background-color: var(--primary-red) !important;">
              <i class="bi bi-box-seam me-1"></i>
              <%= @product_category.products.count %> produk
            </span>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Tanggal Dibuat</div>
          <div class="info-value">
            <i class="bi bi-calendar me-2"></i>
            <%= @product_category.created_at.strftime("%d %B %Y, %H:%M WIB") %>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Terakhir Diupdate</div>
          <div class="info-value">
            <i class="bi bi-clock me-2"></i>
            <%= @product_category.updated_at.strftime("%d %B %Y, %H:%M WIB") %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="detail-card">
        <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
          <i class="bi bi-gear me-2"></i>Aksi
        </h3>
        
        <div class="d-grid gap-2">
          <%= link_to edit_product_category_path(@product_category), class: "btn btn-zarba" do %>
            <i class="bi bi-pencil me-2"></i>Edit Kategori
          <% end %>
          
          <%= link_to product_categories_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-list me-2"></i>Daftar Kategori
          <% end %>

          <%= button_to product_category_path(@product_category), 
              method: :delete,
              data: { 
                turbo_confirm: "Apakah Anda yakin ingin menghapus kategori ini? Semua produk dalam kategori ini juga akan terpengaruh." 
              },
              class: "btn btn-outline-danger w-100" do %>
            <i class="bi bi-trash me-2"></i>Hapus Kategori
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @product_category.products.any? %>
    <div class="detail-card mt-4">
      <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
        <i class="bi bi-box-seam me-2"></i>Produk dalam Kategori (<%= @product_category.products.count %>)
      </h3>
      
      <div class="products-grid">
        <% @product_category.products.each do |product| %>
          <div class="product-item">
            <h5 class="fw-bold mb-2"><%= product.name %></h5>
            <p class="text-muted small mb-2">
              <i class="bi bi-tag me-1"></i><%= product.product_type.name %>
            </p>
            <%= link_to product, class: "btn btn-sm btn-outline-primary" do %>
              <i class="bi bi-eye me-1"></i>Lihat Detail
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="detail-card mt-4 text-center py-5">
      <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
      <h5 class="text-muted">Belum ada produk dalam kategori ini</h5>
      <p class="text-muted">Tambahkan produk baru untuk kategori ini.</p>
      <%= link_to new_product_path, class: "btn btn-zarba" do %>
        <i class="bi bi-plus-circle me-2"></i>Tambah Produk
      <% end %>
    </div>
  <% end %>
</div>
