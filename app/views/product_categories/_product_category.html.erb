<div id="<%= dom_id product_category %>" class="product-category-item">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h5 class="fw-bold mb-1" style="color: var(--primary-red);">
        <%= product_category.name.upcase %>
      </h5>
      <small class="text-muted">
        <code><%= product_category.slug %></code>
      </small>
    </div>
    <span class="badge bg-light text-dark">
      <i class="bi bi-box-seam me-1"></i>
      <%= product_category.products.count %> produk
    </span>
  </div>
</div>
