            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to products_path, class: "nav-link d-flex align-items-center gap-1" do %>
              <i class="bi bi-box-seam"></i> Products
            <% end %>
          </li>
        <% end %>
        <li class="nav-item">
