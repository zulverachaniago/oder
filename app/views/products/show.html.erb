<% content_for :title, @product.name %>
<div class="page-header">
  <div class="container">
    <%= render "layouts/partial/breadcrumb" %>
    <div class="d-flex align-items-center gap-3">
      <%= link_to products_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Kembali
      <% end %>
      <div>
        <h1 class="fw-bold mb-2" style="color: var(--primary-red);">
          <i class="bi bi-box-seam me-2"></i><%= @product.name.upcase %>
        </h1>
        <p class="text-muted mb-0">Detail informasi produk</p>
      </div>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="row">
    <div class="col-lg-8">
      <!-- Product Image -->
      <div class="product-image-container">
        <% if @product.image.attached? %>
          <%= image_tag @product.image, class: "product-image", alt: @product.name %>
        <% else %>
          <div class="no-image-placeholder">
            <i class="bi bi-image"></i>
            <p class="mb-0 fw-bold">Tidak ada gambar</p>
            <small>Gambar produk belum diunggah</small>
          </div>
        <% end %>
      </div>

      <div class="detail-card">
        <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
          <i class="bi bi-info-circle me-2"></i>Informasi Produk
        </h3>
        
        <div class="info-item">
          <div class="info-label">Nama Produk</div>
          <div class="info-value"><%= @product.name %></div>
        </div>

        <div class="info-item">
          <div class="info-label">Harga</div>
          <div class="price-display">
            Rp <%= number_to_currency(@product.price || 0, precision: 0, unit: '', delimiter: '.', separator: ',', format: '%n %u') %>
          </div>
        </div>

        <% if @product.description.present? %>
          <div class="info-item">
            <div class="info-label">Deskripsi</div>
            <div class="info-value" style="font-weight: normal; line-height: 1.6;">
              <%= simple_format(@product.description) %>
            </div>
          </div>
        <% end %>

        <div class="info-item">
          <div class="info-label">Kategori</div>
          <div class="info-value">
            <span class="badge-category">
              <i class="bi bi-tag me-1"></i>
              <%= @product.product_category.name %>
            </span>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Tipe Produk</div>
          <div class="info-value">
            <span class="badge-category">
              <i class="bi bi-grid me-1"></i>
              <%= @product.product_type.name %>
            </span>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Slug</div>
          <div class="info-value">
            <code style="background: #f0f0f0; padding: 5px 10px; border-radius: 5px; font-size: 0.9rem;">
              <%= @product.slug %>
            </code>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Tanggal Dibuat</div>
          <div class="info-value">
            <i class="bi bi-calendar me-2"></i>
            <%= @product.created_at.strftime("%d %B %Y, %H:%M WIB") %>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Terakhir Diupdate</div>
          <div class="info-value">
            <i class="bi bi-clock me-2"></i>
            <%= @product.updated_at.strftime("%d %B %Y, %H:%M WIB") %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="detail-card">
        <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
          <i class="bi bi-gear me-2"></i>Aksi
        </h3>
        
        <div class="d-grid gap-2">
          <%= link_to edit_product_path(@product), class: "btn btn-zarba" do %>
            <i class="bi bi-pencil me-2"></i>Edit Produk
          <% end %>
          
          <%= link_to products_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-list me-2"></i>Daftar Produk
          <% end %>

          <%= button_to product_path(@product), 
              method: :delete,
              data: { 
                turbo_confirm: "Apakah Anda yakin ingin menghapus produk ini?" 
              },
              class: "btn btn-outline-danger w-100" do %>
            <i class="bi bi-trash me-2"></i>Hapus Produk
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
