<% content_for :title, "Products" %>

<% if notice.present? %>
<div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px; border-radius: 10px;">
  <i class="bi bi-check-circle me-2"></i><%= notice %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% end %>

<nav class="navbar navbar-expand-lg sticky-top shadow-sm">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center fw-bold" do %>
    <i class="bi bi-fire me-2 text-danger"></i>
    <span>ZARBA KITCHEN</span>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-lg-3">
        <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "Categories", product_categories_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "Products", products_path, class: "nav-link active fw-bold" %></li>
      </ul>
    </div>
  </div>
</nav>

<div class="page-header">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="fw-bold mb-2" style="color: var(--primary-red);">Products</h1>
        <p class="text-muted mb-0">
          <i class="bi bi-box-seam me-2"></i>
          Total: <strong><%= @products.count %></strong> produk
        </p>
      </div>
      <%= link_to new_product_path, class: "btn btn-zarba" do %>
      <i class="bi bi-plus-circle me-2"></i>Tambah Produk
      <% end %>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="search-box mb-3">
    <div class="card">
      <div class="card-body">
        <%= search_form_for(@q, url: products_path, method: :get, html: { class: "d-flex gap-2 align-items-end flex-wrap" }) do |f| %>
        <div class="flex-grow-1">
          <%= f.label :name_or_slug_cont, "Cari Kategori", class: "form-label fw-bold mb-2" %>
          <%= f.search_field :name_or_slug_cont, 
                class: "form-control form-control-lg", 
                placeholder: "Masukkan nama kategori...",
                value: params.dig(:q, :name_or_slug_cont) %>
        </div>

        <div class="flex-grow-1">
          <%= f.label :product_category_id_eq, "Cari Kategori", class: "form-label fw-bold mb-2" %>
          <%= f.collection_select :product_category_id_eq, ProductCategory.all, :id, :name, { include_blank: true }, { class: "form-control form-control-lg" } %>
        </div>

        <div class="flex-grow-1">
          <%= f.label :product_type_id_eq, "Cari Tipe", class: "form-label fw-bold mb-2" %>
          <%= f.collection_select :product_type_id_eq, ProductType.all, :id, :name, { include_blank: true }, { class: "form-control form-control-lg" } %>
        </div>

        <div>
          <%= f.submit "Cari", class: "btn btn-zarba btn-lg" %>
          <%= link_to "Reset", product_categories_path, class: "btn btn-outline-secondary btn-lg" %>
        </div>
        <% end %>
      </div>
    </div>
  </div>
  <div id="products">
    <% if @products.any? %>
    <div class="table-container">
      <table class="table table-hover">
        <thead>
          <tr>
            <th scope="col" style="width: 5%;">#</th>
            <th scope="col" style="width: 25%;">Nama Produk</th>
            <th scope="col" style="width: 15%;">Kategori</th>
            <th scope="col" style="width: 15%;">Tipe</th>
            <th scope="col" style="width: 15%;" class="text-end">Harga</th>
            <th scope="col" style="width: 10%;" class="text-center">Status</th>
            <th scope="col" style="width: 15%;" class="text-center">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each_with_index do |product, index| %>
          <tr>
            <td class="fw-bold text-muted"><%= index + 1 %></td>
            <td>
              <div class="product-name"><%= product.name %></div>
              <% if product.description.present? %>
              <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
                <%= truncate(product.description, length: 50) %>
              </small>
              <% end %>
            </td>
            <td>
              <span class="badge-category">
                <i class="bi bi-tag me-1"></i>
                <%= product.product_category.name %>
              </span>
            </td>
            <td>
              <span class="badge-category">
                <i class="bi bi-grid me-1"></i>
                <%= product.product_type.name %>
              </span>
            </td>
            <td class="text-end">
              <span class="price-value">
                Rp
                <%= number_to_currency(product.price || 0, precision: 0, unit: '', delimiter: '.', separator: ',', format: '%n %u') %>
              </span>
            </td>
            <td class="text-center">
              <span class="badge bg-success">
                <i class="bi bi-check-circle me-1"></i>Aktif
              </span>
            </td>
            <td class="text-center action-buttons">
              <div class="d-flex gap-2 justify-content-center">
                <%= link_to product, class: "btn btn-sm btn-outline-primary", title: "Lihat Detail" do %>
                <i class="bi bi-eye"></i>
                <% end %>
                <%= link_to edit_product_path(product), class: "btn btn-sm btn-outline-secondary", title: "Edit" do %>
                <i class="bi bi-pencil"></i>
                <% end %>
                <% if current_user.is_admin? %>
                  <%= link_to product_path(product), 
                          data: { 
                            turbo_method: :delete,
                            turbo_confirm: "Apakah Anda yakin ingin menghapus produk ini?" 
                          },
                          class: "btn btn-sm btn-outline-danger", title: "Hapus" do %>
                  <i class="bi bi-trash"></i>
                <% end %>
                <% end %>
              </div>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
      <% if @products.total_pages > 1 %>
      <div class="d-flex justify-content-center mt-4">
        <%= paginate @products, window: 2, outer_window: 1 %>
      </div>
      <% end %>
    </div>
    <% else %>
    <div class="text-center py-5">
      <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
      <h4 class="text-muted">Tidak ada produk ditemukan</h4>
      <p class="text-muted">Mulai dengan menambahkan produk baru.</p>
      <%= link_to new_product_path, class: "btn btn-zarba" do %>
      <i class="bi bi-plus-circle me-2"></i>Tambah Produk Pertama
      <% end %>
    </div>
    <% end %>
  </div>
</div>