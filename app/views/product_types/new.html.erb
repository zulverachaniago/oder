<% content_for :title, "Tambah Tipe Produk Baru" %>
<div class="page-header">
  <div class="container">
    <%= render "layouts/partial/breadcrumb" %>
    <div class="d-flex align-items-center gap-3">
      <%= link_to product_types_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Kembali
      <% end %>
      <div>
        <h1 class="fw-bold mb-2" style="color: var(--primary-red);">
          <i class="bi bi-plus-circle me-2"></i>Tambah Tipe Produk Baru
        </h1>
        <p class="text-muted mb-0">Buat tipe produk baru untuk mengelompokkan produk</p>
      </div>
    </div>
  </div>
</div>

<div class="container mb-5">
  <%= render "form", product_type: @product_type %>
</div>
