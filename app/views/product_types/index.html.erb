<% content_for :title, "Product Types" %>
<div class="page-header">
  <div class="container">
    <%= render "layouts/partial/breadcrumb" %>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="fw-bold mb-2" style="color: var(--primary-red);">Product Types</h1>
        <p class="text-muted mb-0">
          <i class="bi bi-grid-3x3-gap me-2"></i>
          Total: <strong><%= @product_types.count %></strong> tipe produk
        </p>
      </div>
      <%= link_to new_product_type_path, class: "btn btn-zarba" do %>
        <i class="bi bi-plus-circle me-2"></i>Tambah Tipe Produk
      <% end %>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div id="product_types">
    <% if @product_types.any? %>
      <div class="table-container">
        <table class="table table-hover">
          <thead>
            <tr>
              <th scope="col" style="width: 5%;">#</th>
              <th scope="col" style="width: 30%;">Nama Tipe</th>
              <th scope="col" style="width: 25%;">Kategori</th>
              <th scope="col" style="width: 20%;" class="text-center">Jumlah Produk</th>
              <th scope="col" style="width: 20%;" class="text-center">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% @product_types.each_with_index do |product_type, index| %>
              <tr>
                <td class="fw-bold text-muted"><%= index + 1 %></td>
                <td>
                  <div class="type-name"><%= product_type.name %></div>
                  <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
                    <code><%= product_type.slug %></code>
                  </small>
                </td>
                <td>
                  <span class="badge-category">
                    <i class="bi bi-tag me-1"></i>
                    <%= product_type.product_category.name %>
                  </span>
                </td>
                <td class="text-center">
                  <span class="badge bg-light text-dark">
                    <i class="bi bi-box-seam me-1"></i>
                    <%= product_type.products.count %> produk
                  </span>
                </td>
                <td class="text-center action-buttons">
                  <div class="d-flex gap-2 justify-content-center">
                    <%= link_to product_type, class: "btn btn-sm btn-outline-primary", title: "Lihat Detail" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_product_type_path(product_type), class: "btn btn-sm btn-outline-secondary", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to product_type_path(product_type), 
                        data: { 
                          turbo_method: :delete,
                          turbo_confirm: "Apakah Anda yakin ingin menghapus tipe produk ini?" 
                        },
                        class: "btn btn-sm btn-outline-danger", title: "Hapus" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
        <h4 class="text-muted">Tidak ada tipe produk ditemukan</h4>
        <p class="text-muted">Mulai dengan menambahkan tipe produk baru.</p>
        <%= link_to new_product_type_path, class: "btn btn-zarba" do %>
          <i class="bi bi-plus-circle me-2"></i>Tambah Tipe Produk Pertama
        <% end %>
      </div>
    <% end %>
  </div>
</div>
