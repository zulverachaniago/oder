<% content_for :title, @product_type.name %>
<div class="page-header">
  <div class="container">
    <%= render "layouts/partial/breadcrumb" %>
    <div class="d-flex align-items-center gap-3">
      <%= link_to product_types_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Kembali
      <% end %>
      <div>
        <h1 class="fw-bold mb-2" style="color: var(--primary-red);">
          <i class="bi bi-grid me-2"></i><%= @product_type.name.upcase %>
        </h1>
        <p class="text-muted mb-0">Detail informasi tipe produk</p>
      </div>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="row">
    <div class="col-lg-8">
      <div class="detail-card">
        <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
          <i class="bi bi-info-circle me-2"></i>Informasi Tipe Produk
        </h3>
        
        <div class="info-item">
          <div class="info-label">Nama Tipe Produk</div>
          <div class="info-value"><%= @product_type.name %></div>
        </div>

        <div class="info-item">
          <div class="info-label">Kategori</div>
          <div class="info-value">
            <span class="badge-category">
              <i class="bi bi-tag me-1"></i>
              <%= @product_type.product_category.name %>
            </span>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Slug</div>
          <div class="info-value">
            <code style="background: #f0f0f0; padding: 5px 10px; border-radius: 5px; font-size: 0.9rem;">
              <%= @product_type.slug %>
            </code>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Jumlah Produk</div>
          <div class="info-value">
            <span class="badge bg-primary" style="background-color: var(--primary-red) !important;">
              <i class="bi bi-box-seam me-1"></i>
              <%= @product_type.products.count %> produk
            </span>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Tanggal Dibuat</div>
          <div class="info-value">
            <i class="bi bi-calendar me-2"></i>
            <%= @product_type.created_at.strftime("%d %B %Y, %H:%M WIB") %>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Terakhir Diupdate</div>
          <div class="info-value">
            <i class="bi bi-clock me-2"></i>
            <%= @product_type.updated_at.strftime("%d %B %Y, %H:%M WIB") %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="detail-card">
        <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
          <i class="bi bi-gear me-2"></i>Aksi
        </h3>
        
        <div class="d-grid gap-2">
          <%= link_to edit_product_type_path(@product_type), class: "btn btn-zarba" do %>
            <i class="bi bi-pencil me-2"></i>Edit Tipe Produk
          <% end %>
          
          <%= link_to product_types_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-list me-2"></i>Daftar Tipe Produk
          <% end %>

          <%= button_to product_type_path(@product_type), 
              method: :delete,
              data: { 
                turbo_confirm: "Apakah Anda yakin ingin menghapus tipe produk ini? Semua produk dalam tipe ini juga akan terpengaruh." 
              },
              class: "btn btn-outline-danger w-100" do %>
            <i class="bi bi-trash me-2"></i>Hapus Tipe Produk
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @product_type.products.any? %>
    <div class="detail-card mt-4">
      <h3 class="fw-bold mb-4" style="color: var(--primary-red);">
        <i class="bi bi-box-seam me-2"></i>Produk dalam Tipe Ini (<%= @product_type.products.count %>)
      </h3>
      
      <div class="products-grid">
        <% @product_type.products.each do |product| %>
          <div class="product-item">
            <h5 class="fw-bold mb-2"><%= product.name %></h5>
            <p class="text-muted small mb-2">
              <i class="bi bi-tag me-1"></i><%= product.product_category.name %>
            </p>
            <p class="fw-bold mb-2" style="color: var(--primary-red);">
              Rp <%= number_to_currency(product.price || 0, precision: 0, unit: '', delimiter: '.', separator: ',', format: '%n %u') %>
            </p>
            <%= link_to product, class: "btn btn-sm btn-outline-primary" do %>
              <i class="bi bi-eye me-1"></i>Lihat Detail
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="detail-card mt-4 text-center py-5">
      <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
      <h5 class="text-muted">Belum ada produk dalam tipe ini</h5>
      <p class="text-muted">Tambahkan produk baru untuk tipe ini.</p>
      <%= link_to new_product_path, class: "btn btn-zarba" do %>
        <i class="bi bi-plus-circle me-2"></i>Tambah Produk
      <% end %>
    </div>
  <% end %>
</div>
