<% if @signature_product %>
<header class="hero-section" id="signature">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="badge-promo">Menu Andalan</div>
        <h1 class="hero-title mb-4"><%= @signature_product.name.upcase %></h1>
        <p class="lead text-muted mb-4">
          <%= @signature_product.description %>
        </p>
        <div class="d-flex gap-3">
          <a href="#menu" class="btn btn-zarba btn-lg shadow-lg">Lihat Menu Utama</a>
          <button class="btn btn-outline-dark rounded-pill px-4"><i class="bi bi-geo-alt me-2"></i>Lokasi</button>
        </div>
        <div class="mt-4">
          <span class="me-3 text-muted"><i class="bi bi-check2-circle text-danger me-1"></i> 100% Halal</span>
          <span class="text-muted"><i class="bi bi-check2-circle text-danger me-1"></i> Higienis</span>
        </div>
      </div>
      <div class="col-lg-6 mt-5 mt-lg-0">
        <% if @signature_product.image.attached? %>
          <%= image_tag @signature_product.image, class: 'img-fluid hero-img', alt: @signature_product.name %>
        <% else %>
          <%= image_tag('iga_bakar.png', class: 'img-fluid hero-img', alt: @signature_product.name) %>
        <% end %>
      </div>
    </div>
  </div>
</header>
<% end %>

<section class="container mb-5" id="menu">
  <div class="d-flex justify-content-between align-items-end mb-5 flex-wrap gap-3">
    <div>
      <h2 class="fw-bold mb-0">Menu</h2>
      <div style="width: 60px; height: 5px; background: var(--primary-red); margin-top: 10px;"></div>
    </div>
    <ul class="nav nav-pills" id="pills-tab" role="tablist">
      <% @product_categories.each_with_index do |product_category, index| %>
        <li class="nav-item" role="presentation">
          <button
            class="nav-link <%= 'active' if index == 0 %>"
            id="pills-<%= product_category.id %>-tab"
            data-bs-toggle="tab"
            data-bs-target="#pills-<%= product_category.id %>"
            type="button"
            role="tab"
            aria-controls="pills-<%= product_category.id %>"
            aria-selected="<%= index == 0 ? 'true' : 'false' %>">
            <%= product_category.name.upcase %>
          </button>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="tab-content" id="pills-tabContent">
    <% @product_categories.each_with_index do |product_category, index| %>
      <div
        class="tab-pane fade <%= 'show active' if index == 0 %>"
        id="pills-<%= product_category.id %>"
        role="tabpanel"
        aria-labelledby="pills-<%= product_category.id %>-tab">
        <% if product_category.products.any? %>
          <% product_category.products.group_by(&:product_type).each do |product_type, products| %>
            <div class="mb-5">
              <h4 class="fw-bold mb-4 text-uppercase" style="color: var(--primary-red);">
                <%= product_type.name %>
              </h4>
              <div class="row g-4">
                <% products.each do |product| %>
                  <div class="col-md-4">
                    <div class="card menu-card h-100 shadow-sm">
                      <div class="card-img-wrapper">
                        <% if product.image.attached? %>
                          <%= image_tag product.image, class: 'card-img-top menu-img', alt: product.name %>
                        <% else %>
                          <%= image_tag('iga_bakar.png', class: 'card-img-top menu-img', alt: product.name) %>
                        <% end %>
                      </div>
                      <div class="card-body p-4">
                        <h5 class="fw-bold"><%= product.name.upcase %></h5>
                        <p class="text-muted small"><%= product.description %></p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                          <h5 class="mb-0 text-danger fw-bold">Rp <%= number_to_currency(product.price, precision: 0, unit: '', delimiter: '.', separator: ',', format: '%n %u') %></h5>
                          <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="openOrder('<%= j product.name %>', <%= product.price %>)">Pesan</button>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted text-center py-5">Belum ada produk dalam kategori ini.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<footer class="footer-zarba text-white py-5">
  <div class="container text-center">
    <h4 class="fw-bold mb-3"><i class="bi bi-fire me-2"></i>ZARBA KITCHEN</h4>
    <p class="footer-zarba-tagline mb-4">Rasakan sensasi iga bakar yang meresap hingga ke tulang.</p>
    <div class="d-flex justify-content-center gap-3 mb-4">
      <a href="#" class="text-white fs-4" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
      <a href="#" class="text-white fs-4" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
      <a href="#" class="text-white fs-4" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
    </div>
    <p class="small mb-0 footer-zarba-copy">© <%= Time.current.year %> Zarba Kitchen. Crafted with Love.</p>
  </div>
</footer>

<a href="https://wa.me/6281294484677" class="float-wa" target="_blank" rel="noopener" aria-label="Chat WhatsApp">
  <i class="bi bi-whatsapp"></i>
</a>

<div class="modal fade" id="orderModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold" id="menuName">Detail Pesanan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-bold">Jumlah:</label>
          <input type="number" class="form-control rounded-pill" id="qty" value="1" min="1">
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Catatan (Opsional):</label>
          <textarea class="form-control" id="catatan" rows="2" placeholder="Contoh: Pisah sambal, perbanyak kuah..."></textarea>
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-zarba w-100" onclick="sendToWA()">Kirim ke WhatsApp</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let selectedMenu = "";
    let selectedPrice = 0;
    const myModal = new bootstrap.Modal(document.getElementById('orderModal'));

    function closeWelcome() {
        document.getElementById('welcome-screen').style.opacity = '0';
        setTimeout(() => {
            document.getElementById('welcome-screen').style.display = 'none';
        }, 500);
    }

    function closeWelcomeAndGoToSignature() {
        closeWelcome();
        setTimeout(() => {
            var el = document.getElementById('signature');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
                document.getElementById('menu').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }, 550);
    }

    function openOrder(name, price) {
        selectedMenu = name;
        selectedPrice = price;
        document.getElementById('menuName').innerText = name;
        myModal.show();
    }

    function sendToWA() {
        const qty = document.getElementById('qty').value;
        const catatan = document.getElementById('catatan').value;
        const total = selectedPrice * qty;

        const waNumber = "6281294484677"; // GANTI DENGAN NOMOR WA ANDA
        const text = `Halo Zarba Kitchen, saya mau pesan via *Oder*:%0A%0A` +
                     `*Menu:* ${selectedMenu}%0A` +
                     `*Jumlah:* ${qty} porsi%0A` +
                     `*Catatan:* ${catatan || "-"}%0A%0A` +
                     `*Total Estimasi:* Rp ${total.toLocaleString('id-ID')}%0A%0A` +
                     `Mohon diproses ya, terima kasih!`;

        window.open(`https://wa.me/${waNumber}?text=${text}`, '_blank');
    }
</script>
