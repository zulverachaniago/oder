<% content_for :title, "JDE" %>

<% if notice.present? %>
  <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px; border-radius: 10px;">
    <i class="bi bi-check-circle me-2"></i><%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<nav class="navbar navbar-expand-lg sticky-top shadow-sm">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center fw-bold" do %>
      <i class="bi bi-fire me-2 text-danger"></i>
      <span>ZARBA KITCHEN</span>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-lg-3">
        <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "Categories", product_categories_path, class: "nav-link active fw-bold" %></li>
        <li class="nav-item"><%= link_to "Products", products_path, class: "nav-link" %></li>
      </ul>
    </div>
  </div>
</nav>

<div class="page-header">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="fw-bold mb-2" style="color: var(--primary-red);">Product Categories</h1>
        <p class="text-muted mb-0">
          <i class="bi bi-grid-3x3-gap me-2"></i>
          Total: <strong><%= @total_categories %></strong> kategori
        </p>
      </div>
      <%= link_to new_product_category_path, class: "btn btn-zarba" do %>
        <i class="bi bi-plus-circle me-2"></i>Tambah Kategori
      <% end %>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="search-box">
    <%= form_tag(mypages_jde_path, :method =>"get") do %>
      <div class="flex-grow-1">
        <%= search_field_tag :item_number, params[:item_number], placeholder:"Item Number", class:"form-control mb-3", autofocus: true, value:""%>
      </div>
      <div class="actions">
        <%= content_tag(:button,'submit', class:"actions btn btn-primary", type: "submit") %>
                
        <%= link_to "Reset", mypages_jde_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>

  <p><%= @item_number_value %></p>
  <p><%= @jde_data %></p>

</div>
