<style>
  :root {
    --maroon: #8B0000;
    --tomato: #FF6347;
    --bg-gray: #E9E9E9;
    --primary-red: #8B0000;
    --text-muted: #565656;
  }
  body { background-color: var(--bg-gray); font-family: 'Segoe UI', sans-serif; }
  .btn-zarba {
    background-color: var(--maroon); color: white;
    padding: 12px 35px; border-radius: 50px; font-weight: bold; border: none;
  }
  .btn-zarba:hover { background-color: var(--tomato); color: white; }
  .login-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    padding: 2.5rem;
    max-width: 420px;
  }
  .login-title { color: var(--primary-red); font-weight: 800; margin-bottom: 0.5rem; }
  .login-subtitle { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem; }
  .form-control:focus { border-color: var(--primary-red); box-shadow: 0 0 0 0.2rem rgba(139, 0, 0, 0.2); }
  .login-card .devise-links p { margin-bottom: 0.5rem; }
  .login-card .devise-links a { color: var(--primary-red); text-decoration: none; font-weight: 500; }
  .login-card .devise-links a:hover { color: var(--tomato); text-decoration: underline; }
  .password-wrapper .form-control { padding-right: 3rem; }
  .password-wrapper .btn-password-toggle { position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); border: none; background: none; color: var(--text-muted); padding: 0.25rem; line-height: 1; }
  .password-wrapper .btn-password-toggle:hover { color: var(--primary-red); }
</style>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="login-card mx-auto">
        <h2 class="login-title">Log in</h2>
        <p class="login-subtitle">Masuk ke akun Anda untuk mengelola menu.</p>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "devise-form" }) do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: "form-label fw-semibold" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg rounded-pill", placeholder: "nama@email.com" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label fw-semibold" %>
            <div class="password-wrapper position-relative">
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg rounded-pill", placeholder: "••••••••" %>
              <button type="button" class="btn-password-toggle" onclick="togglePassword(this)" aria-label="Tampilkan password" title="Tampilkan password">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="mb-4">
              <div class="form-check">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, class: "form-check-label text-muted" %>
              </div>
            </div>
          <% end %>

          <div class="d-grid mb-3">
            <%= f.submit "Log in", class: "btn btn-zarba btn-lg" %>
          </div>
        <% end %>

        <div class="devise-links text-center pt-3 border-top">
          <div class="d-flex justify-content-center flex-wrap gap-2 align-items-center mb-2">
            <%= link_to "Back to home", root_path %>
            <% if devise_mapping.registerable? %>
              <span class="text-muted">|</span>
              <%= link_to "Sign up", new_registration_path(resource_name) %>
            <% end %>
          </div>
          <% if devise_mapping.recoverable? %>
            <p class="mb-0"><%= link_to "Forgot your password?", new_password_path(resource_name) %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function togglePassword(btn) {
    var wrap = btn.closest('.password-wrapper');
    var input = wrap.querySelector('input');
    var icon = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.remove('bi-eye');
      icon.classList.add('bi-eye-slash');
      btn.setAttribute('aria-label', 'Sembunyikan password');
      btn.setAttribute('title', 'Sembunyikan password');
    } else {
      input.type = 'password';
      icon.classList.remove('bi-eye-slash');
      icon.classList.add('bi-eye');
      btn.setAttribute('aria-label', 'Tampilkan password');
      btn.setAttribute('title', 'Tampilkan password');
    }
  }
</script>
